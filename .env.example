# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# AI (Gemini)
GEMINI_API_KEY=

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Encryption (application-layer, 32-byte hex)
ENCRYPTION_KEY=

# Admin panel (comma-separated emails)
ADMIN_EMAILS=radheshyambhatiig@gmail.com,khushiagarwalg1@gmail.com
# Comma-separated origins allowed to call the API cross-origin (optional).
# Same-origin and localhost are always allowed. Example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_MONTHLY=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_YEARLY=
STRIPE_PRO_PRICE_ID_MONTHLY=
STRIPE_PRO_PRICE_ID_YEARLY=

# Email (Resend — notification emails + password reset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AI Resume Builder <onboarding@resend.dev>

# LinkedIn profile import (Proxycurl — free tier ~10 credits/month)
PROXYCURL_API_KEY=

# Vercel Cron (daily GitHub poll) — set this to a random string in Vercel.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`; other schedulers
# can use the `x-cron-secret` header.
CRON_SECRET=

# Upstash Redis — alternative to raw REDIS_URL. The app uses ioredis under the
# hood, so set REDIS_URL to the TLS endpoint (rediss://...:6379) or the REST
# fields below. When REDIS_URL is unset, rate limiting falls back to in-memory
# and BullMQ jobs run inline instead of being queued.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis (ioredis connection string — use this directly or derive from Upstash)
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

# Sentry (source map uploads; runtime DSN auto-detected by @sentry/nextjs)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
