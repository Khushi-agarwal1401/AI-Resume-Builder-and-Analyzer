# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Gemini)
GEMINI_API_KEY=

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Encryption (application-layer, 32-byte hex)
# ENCRYPTION_KEY_PREVIOUS is only needed during key rotation — set it to the
# old key while rotating so already-encrypted tokens stay decryptable.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Cron jobs (sent in the x-cron-secret header; see vercel.json)
CRON_SECRET=

# Admin panel (comma-separated emails)
ADMIN_EMAILS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_MONTHLY=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_YEARLY=
STRIPE_PRO_PRICE_ID_MONTHLY=
STRIPE_PRO_PRICE_ID_YEARLY=

# Redis (rate limiting; falls back to in-memory)
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

# Sentry (source map uploads; runtime DSN auto-detected by @sentry/nextjs)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
