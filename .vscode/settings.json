{
  // Tailwind CSS at-rules (@tailwind, @apply, @layer, etc.) are unknown to the
  // standard CSS language server. This setting suppresses those warnings.
  "css.lint.unknownAtRules": "ignore",

  // Recommended extensions for the workspace
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss"  // Tailwind CSS IntelliSense
    ]
  }
}
