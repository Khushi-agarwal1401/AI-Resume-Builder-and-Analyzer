{
  "name": "ai-resume-builder-and-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered resume builder and analyzer",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "postbuild": "if [ -d .next/standalone ]; then mkdir -p .next/standalone/.next/static .next/standalone/public && cp -r .next/static/. .next/standalone/.next/static/ 2>/dev/null && cp -r public/. .next/standalone/public/ 2>/dev/null && echo 'Copied static assets to standalone build'; fi",
    "start": "next start",
    "lint": "eslint . --max-warnings 200",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "worker": "tsx src/workers/ai-worker.ts",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/generate-supabase-types.mjs",
    "db:migrate": "node -e \"console.log('Run migrations from supabase/migrations/ in order: 00001_schema.sql, 00002_job_analyses.sql, 00003_subscriptions.sql, 00004_admin_role.sql')\"",
    "db:seed": "node -e \"console.log('Seed data is included in 00003_subscriptions.sql (subscription_plans)')\"",
    "db:reset": "echo 'WARNING: This will drop all tables. Run supabase/migrations/ manually via the Supabase SQL editor.'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khushi-agarwal1401/AI-Resume-Builder-and-Analyzer.git"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.67.0",
    "@stripe/stripe-js": "^9.10.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.101.4",
    "bullmq": "^6.0.8",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.14",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "glob": "^11.1.0",
    "postcss": "^8.5.10",
    "sharp": "^0.35.0",
    "brace-expansion": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@next/eslint-plugin-next": "^16.2.11",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.4.0",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jszip": "^3.10.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
